# Copy to .env.local for local development — never commit .env.local
# (Vercel variables — see README "Services & Environment Variables")

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (document extraction, CIM summaries, digest)
ANTHROPIC_API_KEY=

# Email sending
POSTMARK_SERVER_TOKEN=
FROM_EMAIL=

# File storage
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Secrets — used by the cron routes (CRON_SECRET) and the email-intake
# webhook / relay (INTERNAL_WEBHOOK_SECRET). Generate long random values.
CRON_SECRET=
INTERNAL_WEBHOOK_SECRET=

# Team / app
NEXT_PUBLIC_TEAM_EMAIL=
NEXT_PUBLIC_APP_URL=
